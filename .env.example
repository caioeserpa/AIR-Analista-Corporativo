# --- Provedores (padrão: ollama | alternativas LLM: gemini, claude | embeddings: gemini) ---
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Ollama (Padrão - local) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0
EMBEDDING_MODEL=nomic-embed-text

# --- Alternativa: Google Gemini ---
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_API_KEY=sua_chave_google_aqui

# --- Alternativa: Anthropic Claude (apenas LLM; use embeddings ollama ou gemini) ---
# LLM_PROVIDER=claude
# LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# --- Banco Vetorial (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/assistente_db
COLLECTION_NAME=politica_viagens

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=assistente_db

# --- Parâmetros do RAG ---
TOP_K=4
CHUNKS_DIR=chunks
RERANK_TOP_N=3
MAX_RETRIES=2
